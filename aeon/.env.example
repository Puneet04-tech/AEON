# ---------------------------------------------------------------------------
# AEON environment. Copy to .env and fill in. NEVER commit .env.
# Money is integer micro-USD everywhere: 1 USD = 1,000,000.
# All PayPal activity is SANDBOX ONLY. Real money is never moved.
# ---------------------------------------------------------------------------

# Service
APP_ENV=dev                 # dev | staging | production
AUTO_SEED=true              # seed the five demo agents on an empty database
LOG_LEVEL=INFO

# Database ---------------------------------------------------------------
# Real MongoDB (Atlas M0 free tier or local). Least-privilege app user.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=aeon
# Local demo only: process-local database, discarded on restart.
# MONGODB_URI=memory://

# PayPal (sandbox) -------------------------------------------------------
# Create a sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
# The treasury must be a Business account; agent emails are Personal sandbox accounts.
PAYPAL_ENV=sandbox
PAYPAL_MODE=sandbox         # sandbox only; credentials are required for funding/payouts
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_RETURN_URL=http://localhost:8000/?funding=return
PAYPAL_CANCEL_URL=http://localhost:8000/?funding=cancel
# Order currency. Keep USD for an IN merchant profile: PayPal rejects INR orders
# with 422 CURRENCY_NOT_SUPPORTED, and an INR-only payer account fails checkout
# with "currency is not valid". The payer must be a USD-capable sandbox account.
# PAYPAL_USD_TO_INR is only used if PAYPAL_CURRENCY is set to INR.
PAYPAL_CURRENCY=USD
PAYPAL_USD_TO_INR=83.0

# Treasury and settlement limits (micro-USD) ------------------------------
TREASURY_RESERVE_MICRO=20000000        # 20.00 USD kept unspent in the float
PAYOUT_MIN_MICRO=10000                 # 0.01 USD PayPal minimum
PAYOUT_DAILY_CAP_MICRO=1000000000      # 1000.00 USD per day
APPROVAL_THRESHOLD_MICRO=25000000      # 25.00 USD needs human approval
FUNDING_MAX_MICRO=50000000             # 50.00 USD per top-up
MAX_TRADE_MICRO=5000000                # 5.00 USD per trade

# Cloudflare Workers AI (LLM) --------------------------------------------
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/meta/llama-3.1-8b-instruct
LLM_MODE=live               # live | replay | off
LLM_CACHE_PATH=.llm_cache.json

# Secrets ---------------------------------------------------------------
SESSION_SECRET=replace-with-64-random-chars
HMAC_SHARED_SECRET=replace-with-64-random-chars   # shared with every worker
# bcrypt hash of the operator password: python -c "from app.security import hash_password; print(hash_password('...'))"
OPERATOR_PASSWORD_HASH=
# Dev-only convenience fallback; never set this in production.
OPERATOR_PASSWORD=demo-operator

# Workers ---------------------------------------------------------------
WORKER_URLS=http://localhost:8001,http://localhost:8002
WORKER_TIMEOUT_SECONDS=15

# Web -------------------------------------------------------------------
ALLOWED_ORIGIN=http://localhost:5173
DASHBOARD_DIR=dashboard/dist
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=120

# Judge mode ------------------------------------------------------------
JUDGE_SESSION_MINUTES=30
JUDGE_SCENARIO_QUOTA=10

# Forecasts (real weather, simulated pricing) ----------------------------
ENABLE_FORECASTS=true
WEATHER_LAT=37.7749
WEATHER_LON=-122.4194
WEATHER_CACHE_SECONDS=900
