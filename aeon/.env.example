# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB=aeon

# PayPal Sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_webhook_id
PAYPAL_ENV=sandbox

# Treasury & Limits (micro-USD: 1 USD = 1,000,000)
TREASURY_RESERVE_MICRO=10000000000
PAYOUT_MIN_MICRO=10000
PAYOUT_DAILY_CAP_MICRO=1000000000
APPROVAL_THRESHOLD_MICRO=25000000

# Cloudflare Workers AI
CF_ACCOUNT_ID=your_account_id
CF_API_TOKEN=your_api_token
CF_MODEL=@cf/meta/llama-3.1-8b-instruct
LLM_PROVIDERS=cloudflare
LLM_MODE=live

# Security
SESSION_SECRET=generate_long_random_string
HMAC_SHARED_SECRET=generate_long_random_string
OPERATOR_PASSWORD_HASH=bcrypt_hash_here

# Workers
WORKER_URLS=http://localhost:8001,http://localhost:8002

# API Security
ALLOWED_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100
JUDGE_SESSION_MINUTES=30
JUDGE_SCENARIO_QUOTA=10
